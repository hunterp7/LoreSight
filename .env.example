# Optional: enables AI-generated narration and can authorize the Director adapter.
# Keep the real value server-side and store it in your deployment secret manager.
OPENAI_API_KEY=

# The Director is a separate, explicit opt-in because each performance uses paid API capacity.
# Authored fallback remains available whenever this is false, missing, or the provider fails.
STORYFRAME_DIRECTOR_ENABLED=false
STORYFRAME_DIRECTOR_MODEL=gpt-5.6-sol
STORYFRAME_DIRECTOR_REASONING_EFFORT=low
STORYFRAME_DIRECTOR_TIMEOUT_MS=20000
STORYFRAME_DIRECTOR_MAX_OUTPUT_TOKENS=1200

# Production New/Remix generation. This is intentionally disabled until the
# privacy notice, rights workflow, and creator-review surface are deployed.
STORYFRAME_GENERATION_ENABLED=false
STORYFRAME_GENERATION_MODEL=gpt-5.6-sol
STORYFRAME_GENERATION_TIMEOUT_MS=45000
STORYFRAME_GENERATION_MAX_OUTPUT_TOKENS=8000

# HTTP listener. The service binds on all interfaces; terminate public traffic at HTTPS.
PORT=8787

# Private-alpha admin only. Use at least 24 random characters; omit to disable admin APIs.
STORYFRAME_ADMIN_PASSWORD=
STORYFRAME_ADMIN_DATA_FILE=.storyframe-data/admin.json

# Production player OAuth. Configure all three together or omit all three for local development.
# STORYFRAME_OAUTH_RESOURCE must be the canonical HTTPS MCP origin, not the /mcp path.
STORYFRAME_OAUTH_ISSUER=https://identity.example.com
STORYFRAME_OAUTH_RESOURCE=https://storyframe.example.com
STORYFRAME_OAUTH_JWKS_URI=https://identity.example.com/.well-known/jwks.json
